# ── Frontend (exposed to browser) ─────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_CIRCLE_APP_ID=your-circle-app-id
VITE_OPENAI_API_KEY=sk-proj-...

# ── Backend (server-side only, never VITE_ prefix) ────────────────────────────
CIRCLE_API_KEY=TEST_API_KEY:...
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
PORT=3001

# ── Paystack (server-side only) ───────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...

# ── Treasury wallet (Circle developer-controlled, funds USDC payouts) ─────────
CIRCLE_TREASURY_WALLET_ID=your-treasury-wallet-id
CIRCLE_ENTITY_SECRET=your-entity-secret
